# Local agent context (not published). Only Muse-related files are committed (MUSE.md).
CLAUDE.md
.claude/
.claude/settings.local.json

# Secrets
.env
.env.*
!.env.example
!.env.production.example
!mobile/.env.example
!backend/.env.backend.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node
node_modules/
web/dist/

# Data (fetched by scripts, never committed)
/data/
*.db

# Expo
.expo/

# Muse Code local state and credentials
.muse/

# Logs: keep only the sanitized sample
logs/*
!logs/sample_muse_calls.jsonl
# Muse cache and raw usage log stay local (covered by logs/* too)
logs/muse_cache/
logs/muse_usage.jsonl

# OS / editor
.DS_Store
.vscode/settings.json

# Module contract folder between ml and backend
artifacts/*
!artifacts/.gitkeep

# Modules
mobile/node_modules/
backend/var/

# DVC and handoff (data lives in DVC/DagsHub, never in git)
models/
.dvc/config.local
.dvc/cache
.dvc/tmp

# Cowork outputs (prompts and drafts, local only)
Claude outputs/

# Agent review reports and scratch files (local only)
reviews/


# Android builds (published as GitHub Release assets, never committed)
*.apk
*.aab
