# Every variable the backend reads. No values here: put them in the root .env (Docker
# Compose) or in backend/.env.backend for a host run. Defaults in parentheses.

# Runtime
APP_ENV=                  # development | demo | production | test (development). production refuses console email and requires SESSION_SECRET
BACKEND_ENV_FILE=         # optional env file for host runs (backend/.env.backend)
BACKEND_VAR_DIR=          # SQLite, logs/muse_usage.jsonl (backend/var; /app/var in Docker)
DATABASE_URL=             # (sqlite:///<BACKEND_VAR_DIR>/frostwatch.db)
RATE_LIMIT_PER_MINUTE=    # requests per minute per client IP (120)
CORS_ORIGINS=             # comma-separated browser origins (http://localhost:8081,http://127.0.0.1:8081)

# Data
DATA_PROVIDER=            # mock | artifacts (mock)
ARTIFACTS_DIR=            # artifacts folder, read-only (/app/artifacts in Docker, else <repo>/artifacts)
COVERAGE_RADIUS_KM=       # circle radius around each cell (30)

# Sessions
SESSION_SECRET=           # long random string, signs the 30-day JWT sessions

# Email (login codes and alerts)
EMAIL_PROVIDER=           # console (default): codes and alerts are printed in the backend log.
                          # smtp also exists (EMAIL_SMTP_HOST/PORT/USER/PASSWORD, EMAIL_FROM in
                          # app/config.py) but this project does not use it.

# Push
EXPO_PUSH_URL=            # (https://exp.host/--/api/v2/push/send)

# Sign in with Google (optional; needs a public https backend URL)
PUBLIC_BASE_URL=          # e.g. https://your-domain; redirect URI is PUBLIC_BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=         # Google Cloud OAuth client, type "Web application"
GOOGLE_CLIENT_SECRET=

# Explanations (Meta Model API, OpenAI-compatible); only used when MUSE_MOCK=0
META_API_KEY=
META_API_BASE_URL=        # base URL that serves /chat/completions
MUSE_MODEL=               # (muse-spark-1.3)
MUSE_MOCK=                # 1 uses the deterministic template, 0 calls the API (1)
MUSE_MAX_TOKENS=          # max_tokens per call, reasoning included (8000)
MUSE_TIMEOUT_S=           # seconds to wait for Muse (120)
MUSE_MAX_CALLS_PER_RUN=   # cap of API calls per processed night (40)
