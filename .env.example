# Copernicus CDS personal access token (token only, no uid prefix)
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_MOCK=0
MUSE_MAX_TOKENS=800
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
DATABASE_URL=sqlite:///./frostwatch.db
DEMO_REPLAY=0

# Backend sessions and public URL (ngrok)
SESSION_SECRET=
PUBLIC_BASE_URL=
DATA_PROVIDER=mock
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Mobile (Expo). EXPO_PUBLIC_* values are bundled into the app: never put secrets there.
HOST_LAN_IP=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_USE_MOCK=1

# Later: Google sign-in (backend only)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
