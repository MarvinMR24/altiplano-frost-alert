# Root environment for a local run (docker compose reads this file). Copy it to .env and fill
# in what you need. Never commit .env. The mobile app has its own file: mobile/.env.example.

# --- Backend --------------------------------------------------------------------------------
# Long random string that signs sessions (openssl rand -base64 48). If empty, sessions end
# whenever the backend restarts.
SESSION_SECRET=
# mock: synthetic data, works with nothing else. artifacts: the real model predictions in
# artifacts/ (dvc pull, then make serving).
DATA_PROVIDER=mock
# Login and verification codes are printed in the backend log (no email is sent):
#   docker compose logs -f backend | grep -iE "codigo|código|code is"
EMAIL_PROVIDER=console

# Muse Spark explanations. MUSE_MOCK=1 uses a fixed template and costs nothing.
MUSE_MOCK=1
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
# Muse Spark counts reasoning tokens here: keep 8000 (lower values cut the answer).
MUSE_MAX_TOKENS=8000

# Optional: sign in with Google. Needs a public https URL for the backend (Google rejects local
# addresses) and a Google Cloud OAuth client of type "Web application" with the redirect URI
# PUBLIC_BASE_URL/auth/google/callback. Leave empty: the button shows "coming soon".
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser origins allowed by CORS (only for the Expo web build).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- ML pipeline (host only, not the backend) -----------------------------------------------
# Copernicus CDS personal access token (token only, no uid prefix) for pipelines/01_download.py.
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api
# MLflow mirror on DagsHub (optional; the local experiments/ folder is the source of truth).
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
