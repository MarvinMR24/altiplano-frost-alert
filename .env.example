# Copernicus CDS personal access token (token only, no uid prefix)
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_MOCK=0
# Muse Spark counts reasoning tokens here: 8000 (lower values cut the answer)
MUSE_MAX_TOKENS=8000
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
DATABASE_URL=sqlite:///./frostwatch.db
DEMO_REPLAY=0

# Backend sessions and public URL (the AWS URL once deployed)
SESSION_SECRET=
PUBLIC_BASE_URL=
# Sign in with Google (optional): a Google Cloud OAuth client of type "Web application" with
# the authorized redirect URI PUBLIC_BASE_URL/auth/google/callback (PUBLIC_BASE_URL must be a
# public https URL). Leave empty to keep the Google button as "coming soon".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATA_PROVIDER=mock
# Browser origins allowed by the backend (Expo web dev server)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Mobile (Expo, runs on the host, reads mobile/.env.local). EXPO_PUBLIC_* values are bundled into the app: never put secrets there.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_USE_MOCK=1


MLFLOW_TRACKING_URI=https://dagshub.com/user/repository
MLFLOW_TRACKING_USERNAME=user
MLFLOW_TRACKING_PASSWORD=password

