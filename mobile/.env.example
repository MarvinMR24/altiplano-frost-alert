# Copy to mobile/.env.local, then restart Metro with a clean cache: npx expo start -c
# EXPO_PUBLIC_* values are bundled into the app: never put secrets here.

# Which backend the app talks to. Pick one:
# 1) The hackathon demo on AWS (available until 2026-11-16):
EXPO_PUBLIC_API_URL=https://174-129-189-202.sslip.io
# 2) Your own backend on your Mac (docker compose up). Use the Mac's Wi-Fi address, not
#    localhost: the phone must reach it (ipconfig getifaddr en0). Same Wi-Fi for both.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000

# 0 talks to the backend above. 1 uses in-app fake data and needs no backend.
EXPO_PUBLIC_USE_MOCK=0
