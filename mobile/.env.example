# Copy to mobile/.env.local (gitignored). EXPO_PUBLIC_* values are bundled into the app:
# never put secrets here.
# Backend URL: the public ngrok URL (https://<name>.ngrok-free.app) or http://<LAN-IP>:8000
EXPO_PUBLIC_API_URL=
# 1 = offline mock data (default), 0 = real backend
EXPO_PUBLIC_USE_MOCK=1
# Optional: EAS project id, needed for Expo push tokens (or run `npx eas-cli init`)
EXPO_PUBLIC_EAS_PROJECT_ID=
