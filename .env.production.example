# Production environment for the AWS server. Copy to .env.production on your Mac, fill it
# in, then upload it with deploy/scripts/sync_env.sh (it becomes .env on the server, mode 600).
# Never commit .env.production. Names only here, no values.

# Runtime mode. "demo" (used for the hackathon server) prints login codes in the server log.
# "production" refuses console email: it needs EMAIL_PROVIDER=smtp and the EMAIL_SMTP_* settings
# read by backend/app/config.py (not used in this project).
APP_ENV=demo
# Public host name served by Caddy with HTTPS, without https:// (your subdomain or <ip-with-dashes>.sslip.io).
DOMAIN=
# Public base URL of the API, https://<DOMAIN>. Used for the Google sign in redirect.
PUBLIC_BASE_URL=
# Long random secret that signs sessions (for example: openssl rand -base64 48).
SESSION_SECRET=
# Serve the precomputed predictions copied to artifacts/ (deploy/scripts/sync_artifacts.sh).
DATA_PROVIDER=artifacts

# Muse Spark explanations through the Meta Model API.
MUSE_MOCK=0
# Meta Model API key (secret).
META_API_KEY=
# Meta Model API base URL.
META_API_BASE_URL=
# Model name.
MUSE_MODEL=muse-spark-1.3
# Token limit per call; Muse Spark counts reasoning tokens, keep 8000.
MUSE_MAX_TOKENS=8000

# Login and verification codes go to the server log (docker compose logs backend).
EMAIL_PROVIDER=console

# Browser origins allowed by CORS, comma separated (your web origin if any; native apps ignore CORS).
CORS_ORIGINS=
# Requests per minute per client address.
RATE_LIMIT_PER_MINUTE=120

# Optional: sign in with Google (Web OAuth client, redirect URI https://<DOMAIN>/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
